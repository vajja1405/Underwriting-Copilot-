{
  "name": "fundproof-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Fundproof web frontend (Founder Studio + Lender Desk). Next.js static export served by the FastAPI app.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "node scripts/run-next.mjs dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "node scripts/run-next.mjs build",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "node scripts/run-next.mjs typegen && tsc --noEmit",
    "serve:static": "python3 -m http.server 4173 --directory out",
    "check:contrast": "node scripts/check-contrast.mjs",
    "mock": "node mock-api/server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "maplibre-gl": "6.11.2",
    "next": "16.3.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
