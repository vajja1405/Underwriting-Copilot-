# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Kaggle (needed for the Lending Club download). Uncomment ONE option and fill it in.
# Option A: generate an API token at https://www.kaggle.com/settings/api ("Generate New Token").
# KAGGLE_API_TOKEN=
# Option B: a legacy API key (the username and key from kaggle.json).
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# If you keep kaggle.json in ~/.kaggle or ~/.config/kaggle instead, leave these commented out.

# LLM provider for document extraction and memos (Phase 2+): anthropic, openai, ollama (a local open-weight model,
# no API key), or fake (offline, for tests).
UWC_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override for the provider above. Defaults: claude-haiku-5-5 (anthropic), gpt-6-luna (openai),
# qwen2.5-3b-instruct-q4km (ollama; import it with scripts/fetch_local_model.py).
# Every model you use needs a verified price in config/llm_pricing.yaml, or calls are refused (local models: 0.0).
UWC_LLM_MODEL=
# Base URLs are read ONLY from these project variables (never from ANTHROPIC_BASE_URL / OPENAI_BASE_URL).
UWC_ANTHROPIC_BASE_URL=https://api.anthropic.com
UWC_OPENAI_BASE_URL=https://api.openai.com/v1
# Local Ollama server (native API). Plain http is accepted only for a loopback host (127.0.0.1, localhost, ::1);
# any other host must use https. No API key is needed.
# UWC_OLLAMA_BASE_URL=http://127.0.0.1:11434
# One Ollama job at a time: scripts that call Ollama hold a file lock (default data/cache/ollama.lock, inside this
# checkout). The server serves the whole machine, so when several checkouts (git worktrees, parallel agents) share
# one server, set the SAME absolute path in each of them, or their jobs will run side by side.
# UWC_OLLAMA_LOCK_PATH=/tmp/uwcopilot-ollama.lock
# Effort for Anthropic requests: low (default), medium, high, xhigh or max. Thinking tokens count toward max_tokens.
# UWC_ANTHROPIC_EFFORT=low
# Where cached LLM responses are kept (default .cache/llm) and the verified price list (default config/llm_pricing.yaml).
# UWC_LLM_CACHE_DIR=.cache/llm
# UWC_LLM_PRICING_FILE=config/llm_pricing.yaml
# Hugging Face Inference Providers (Studio narrative, provider "hf_inference"). DISABLED by default and never run in
# this repository: it is pay-as-you-go. It needs all of: the flag below set to 1, HF_TOKEN, a model id, and that
# model's verified price in config/llm_pricing.yaml (without a price every call is refused before any request).
# UWC_LLM_PROVIDER cannot select it; a caller must ask for "hf_inference" by name.
# UWC_HF_INFERENCE_ENABLED=0
# UWC_HF_INFERENCE_MODEL=
# UWC_HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1

# Hard cost cap in USD for any single run (ground rule 4).
MAX_RUN_COST_USD=10

# ---- Optional services. Everything below is commented out: the defaults work offline. ----

# Vector index (RAG). Unset UWC_QDRANT_URL = embedded Qdrant in the folder UWC_QDRANT_PATH (default qdrant_storage/).
# UWC_QDRANT_URL=http://localhost:6333
# UWC_QDRANT_API_KEY=
# UWC_QDRANT_PATH=qdrant_storage
# UWC_QDRANT_COLLECTION=uwc_guidelines

# Risk scoring REST service, shared by the agent and the MCP server. This is the service's BASE URL: every client
# sends POST <base URL>/score (do not add /score yourself; a value ending in /score is refused). Unset = the
# score_risk tool reports itself unavailable and nothing is sent anywhere. Timeout in seconds (default 10, max 120).
# UWC_RISK_API_URL=http://localhost:8000
# UWC_RISK_API_TIMEOUT_S=10

# Agent state: LangGraph checkpoint database (default .cache/agent/checkpoints.sqlite) and the append-only decision
# log (default data/processed/agent/decision_records.jsonl).
# UWC_AGENT_DB=.cache/agent/checkpoints.sqlite
# UWC_DECISION_LOG=data/processed/agent/decision_records.jsonl

# Security (Phase 5 B, src/uwcopilot/security; see docs/security.md). The audit event log (hash-chained, PII-redacted;
# its head anchor is written next to it as audit_events.head.json) and the folder of the encrypted packet store.
# The encrypted decision log and the packet store use UWC_FERNET_KEY (documented in the web section below). On the
# agent side there is NO fallback key: without UWC_FERNET_KEY they refuse to run. Never commit a key.
# UWC_AUDIT_LOG=data/processed/security/audit_events.jsonl
# UWC_PACKET_STORE=data/processed/security/packets

# OTLP/HTTP traces endpoint, for example a local Arize Phoenix. Unset = spans are created but not exported.
# UWC_OTLP_ENDPOINT=http://localhost:6006/v1/traces

# ---- Founder Studio data connectors (src/uwcopilot/studio/data/keys.py). Free keys; never logged or cached. ----
# Census Data API (ACS 5-year tract tables, County Business Patterns). Without it those steps of `make studio-data` fail.
# CENSUS_API_KEY=
# BLS Public Data API v2 (series such as OEWS wages). QCEW wages are downloaded without a key.
# BLS_API_KEY=
# FRED API. Without it the keyless fredgraph.csv download is used for the prime rate.
# FRED_API_KEY=
# HUD USER API (Fair Market Rents, residential reference only).
# HUD_USER_TOKEN=
# OpenRouteService drive-time areas (optional, Studio S2). Without it distance rings are used.
# ORS_API_KEY=

# ---- Web app (Fundproof, src/uwcopilot/web) and the Hugging Face Space deployment. See docs/deployment.md. ----
# Locally all of these may stay unset (`make web-serve`, `make docker-run`). In the Space, set them in the Space
# settings (Settings -> Variables and secrets), never in a committed file. The .env file never enters the container
# image (.dockerignore), so the Space only sees what its settings define.
#
# Required in the Space (Space SECRET). Signs session cookies; at least 32 characters. Unset outside a Space = a random
# secret per process (sessions end when it restarts). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# UWC_SESSION_SECRET=
# Lender and admin roles ("user@id:role,..."; roles lender_reviewer, lender_senior, admin). Everyone else who signs
# in is a founder. Space secret or variable. Pin each entry to the account id ("subject" in /api/me after signing in
# once): a renamed username can be registered by someone else, an id cannot. "user:role" (unpinned) also works but
# logs a warning in a Space.
# UWC_ROLE_ALLOWLIST=your-hf-username@your-account-id:admin,another-user@their-account-id:lender_reviewer
#
# Storage. local (default) keeps data on the container disk, which a Space loses on every restart. hf_dataset mirrors
# it, encrypted, to a PRIVATE Hugging Face dataset (created private if missing; a public one is refused).
# UWC_STORE=local
# UWC_STORE_DIR=data/web/store
# UWC_HF_DATASET_REPO=your-hf-username/fundproof-data
# HF_TOKEN= (Space secret) a token with write access to that dataset; ideally a fine-grained token for that repo only.
# Fernet key(s) for data at rest, comma-separated, newest first (old keys still decrypt). Required with hf_dataset.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# UWC_FERNET_KEY=
#
# Optional tuning. The defaults (src/uwcopilot/web/settings.py) are design choices for a prototype, not measurements.
# UWC_RETENTION_DAYS=30
# UWC_PURGE_EVERY_S=3600
# UWC_HF_FLUSH_EVERY_S=300
# UWC_SESSION_MAX_AGE_S=28800
# UWC_RATE_LIMIT_IP_PER_MIN=120
# UWC_RATE_LIMIT_IP_BURST=60
# UWC_RATE_LIMIT_USER_PER_MIN=120
# UWC_RATE_LIMIT_USER_BURST=60
# UWC_MAX_BODY_BYTES=10485760
# Heavy jobs (simulation, path search, agent run) run in worker threads (src/uwcopilot/web/services/settings.py).
# A request waits UWC_COMPUTE_TIMEOUT_S seconds, then gets 503 while the job finishes and is cached for the next try.
# UWC_COMPUTE_TIMEOUT_S=60
# UWC_COMPUTE_WORKERS=2
# UWC_COMPUTE_MAX_PENDING=8
# UWC_COMPUTE_CACHE_ENTRIES=256
# Sanctions lists the screening tool loads: all (default: OFAC SDN + OpenSanctions) or ofac (the Space: OpenSanctions
# is not in the image). The threshold was chosen on the full lists; its accuracy on OFAC alone is not measured.
# UWC_SCREENING_LISTS=all
# Proxies in front of the app that append to X-Forwarded-For: default 1 in a Space, 0 elsewhere. The Space value is
# not verified yet (docs/deployment.md, "Check on the first deploy").
# UWC_TRUSTED_PROXY_HOPS=
# Where the frontend export is (default frontend/out) and the commit /api/health shows (the image build sets it).
# UWC_STATIC_DIR=frontend/out
# UWC_GIT_SHA=
# Public base URL for testing Hugging Face sign-in OUTSIDE a Space (the OAuth callback URL is built from it).
# UWC_PUBLIC_URL=
# DEV LOGIN (pick any user and role) for local development only. Startup REFUSES it when SPACE_ID is set.
# UWC_DEV_AUTH=1
# Set by Hugging Face inside the Space, never by you: SPACE_ID, SPACE_HOST, OAUTH_CLIENT_ID, OAUTH_CLIENT_SECRET,
# OAUTH_SCOPES, OPENID_PROVIDER_URL.
#
# GitHub repository secrets for .github/workflows/deploy-space.yml (GitHub: Settings -> Secrets and variables ->
# Actions). They are NOT read from .env:
#   HF_TOKEN     a Hugging Face token with write access that can create and update the Space
#   HF_SPACE_ID  the Space id, owner/name (for example your-hf-username/fundproof)
